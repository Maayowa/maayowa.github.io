@inproceedings{iwakin2023short,
  title={Short-term water demand prediction using machine learning techniques—a case study of telford borough in pennsylvania},
  doi={10.1061/9780784484852.094},
  abstract={Increasing global populations, changing water consumption patterns, and climate change are continuously putting a strain on available water resources. Identifying these changes in consumption patterns and future demand requirements through water demand forecasting plays a key role in the allocation, planning, and management of urban water resources and infrastructure. In the last decades, advances in statistics, machine learning, and artificial intelligence techniques have shown promising results in predicting future water demands. This study aims to forecast hourly water demand, while factoring the effects of other exogenous features on consumption patterns using machine learning techniques for Telford Borough, a predominantly residential town in Pennsylvania, {US}. In this study, the predictive abilities of the support vector machine and the random forest regression models have been compared in forecasting water demand using past demand, and temporal and climatic features. The results demonstrated the practicability of applying machine learning solutions to water management with random forest being the best model, and temporal features being the most important in the exploratory variables. The authors conclude that these predictive models can be used for near real-time forecasting to guide the allocation and planning decisions of water resources.},
  author={Iwakin, Oluwabunmi M and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2023},
  pages={1027--1036},
  year={2023}
}

@article{liu2025rapid,
  title={Rapid characterization of MSW and RDF feedstocks for waste-to-energy process using LIBS and ML techniques},
  doi={10.1016/j.wasman.2025.115079},
  abstract={The heterogeneity in the composition of municipal solid wastes ({MSW}) poses significant challenges in the production of biofuel and bioproducts. This research aims to enhance the accuracy and efficiency of waste analysis and characterization by introducing a fast characterization approach for {MSW}-derived refuse-derived fuels ({RDF}) by combining Laser-Induced Breakdown Spectroscopy ({LIBS}) with advanced machine learning ({ML}) techniques. The approach combines data pre-processing of {LIBS} spectra of {RDF}, and the development of {ML} models trained on domain and theory-based spectral features for predicting process parameters. These models are adept at predicting key process parameters like High Heating Value ({HHV}), carbon content, and volatile matter. This approach can achieve an average {RRMSE} of 2.13\% and R2 of 0.98 or higher for all considered parameters on testing data. This work demonstrates significant potential for improving waste sorting, processing efficiency, and environmental compliance over traditional labor- and time-intensive laboratory waste analysis and characterization.},
  author={Liu, Jincheng and Iwakin, Oluwabunmi and Romero, Carlos E and Cheng, Liang and Moazeni, Faegheh and Yao, Zheng and De Saro, Robert and Craparo, Joseph},
  journal={Waste Management},
  volume={206},
  pages={115079},
  year={2025},
  publisher={Pergamon}
}

@inproceedings{iwakin2025hardware,
  title={Hardware-in-the-Loop Simulation of Data-Driven Economic Dispatch Problem for Integrated Water--Energy Systems},
  doi={10.1061/9780784486184.083},
  abstract={Integrating smart water and energy systems introduces substantial complexities, prompting the development of more advanced algorithms and techniques for their economic and efficient operation. However, applying these algorithms in real-world scenarios, particularly for (near-) real-time economic dispatch problems, presents notable computational challenges. This underscores the need for validated solutions that minimize computational complexity while optimizing power scheduling for water distribution systems. To address this, the present work employs machine learning ({ML}) models to solve integrated water--energy economic dispatch problems in the shortest possible time. A hardware-in-the-loop ({HIL}) water distribution system ({WDS}) testbed is used for data generation and model validation, while a conventional deterministic optimization algorithm is used to obtain the final training data for the {ML} model. The testbed's integration of {WDS} hardware and software components facilitates iterative testing and validation of developed models and algorithms. The findings include reliable real-time solutions to the economic dispatch problem with reduced computational time, showcasing its potential for real-world implementation.},
  author={Iwakin, Oluwabunmi M and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2025},
  pages={886--897},
  year={2025}
}

@article{iwakin2024improving,
  title={Improving urban water demand forecast using conformal prediction-based hybrid machine learning models},
  doi={10.1016/j.jwpe.2023.104721},
  abstract={This paper presents a probabilistic forecasting method that predicts the future water consumption patterns, taking into account the inherent uncertainty in the system. The proposed method leverages statistical techniques to estimate the probability distribution of future water demand scenarios. The findings of this study will provide decision-makers with a range of possible alternatives that facilitate better planning and management of water resources. We developed a conformal prediction-based hybrid demand forecast model, which combines convolutional neural network ({CNN}) and bidirectional long short-term memory ({BiLSTM}) while comparing it with other machine learning models for probabilistic hourly water demand forecasting. Additionally, we address crucial considerations when implementing a probabilistic forecasting system, including selecting appropriate data and choosing model parameters. The performance of the proposed model is validated for probabilistic water demand forecasting in real-world settings. Results indicate noteworthy improvement in deterministic and probabilistic predictions by 10 \% and 26.7 \%, respectively. The findings underscore the potential benefits of this approach for improved decision-making and resource management. The results also demonstrate that the proposed hybrid model outperforms the compared machine learning models with better prediction performance and increased robustness for handling prediction uncertainties.},
  author={Iwakin, Oluwabunmi and Moazeni, Faegheh},
  journal={Journal of Water Process Engineering},
  volume={58},
  pages={104721},
  year={2024},
  publisher={Elsevier}
}

@inproceedings{iwakin2025stochastic,
  title={Stochastic Economic Dispatch for Combined Water--Energy Microgrid Systems Considering Data-Driven Scenario Generation Approach},
  doi={10.1061/9780784486184.097},
  abstract={Numerous bilateral opportunities exist within the water--energy nexus, leading to an increased focus on the efficient operation of combined water--energy microgrid systems. Emphasis is being placed on developing methods that prescribe the most economical and efficient use of distributed energy resources and the design of energy-efficient water systems. However, achieving this objective is often complicated by significant uncertainties in the availability and variability of renewable energy sources, along with fluctuations in water demand, which introduce complexities into the optimization process and impact the reliability of traditional deterministic models. This work develops a k-means algorithm with a scenario reduction method for scenario generation to solve a two-stage stochastic economic dispatch problem. The algorithm is tested for Telford Borough in Pennsylvania. The proposed framework provides reliable economic power dispatch for water supply systems while accounting for uncertainties in future energy demands, which are directly linked to fluctuating water demand. The study demonstrates the advantages of employing a stochastic scheduling approach while comparing it to the deterministic power dispatch results. The findings demonstrate the effectiveness of the method in enhancing operational stability, achieving up to 12\% operational cost savings. They also highlight the importance of accurate forecasting for robust energy dispatch in large-scale integrated water--energy microgrid systems.},
  author={Iwakin, Oluwabunmi M and Moazeni, Faegheh and Khazaei, Javad},
  booktitle={World Environmental and Water Resources Congress 2025},
  pages={1053--1063},
  year={2025}
}

