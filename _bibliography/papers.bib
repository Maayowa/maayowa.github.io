@article{iwakin2025data,
  title={Data-driven economic dispatch towards operational management of distributed energy resources for grid-connected water-energy microgrids},
  doi={10.1016/j.energy.2025.137668},
  abstract={This paper addresses the critical need for economic dispatch optimization in integrated water-microgrid systems by introducing innovative data-driven techniques to overcome computational challenges. Leveraging machine learning models, we achieved rapid resolution of objective functions and constraints in water--energy system dispatch optimization. It effectively tackles the computational challenges associated with dynamic economic dispatch problems in these nonlinear, interdependent, complex systems, showcasing remarkable improvements with computational speed enhancements of over 10⁴ times compared to conventional numerical optimization methods. The accuracy of the machine-learning algorithms is demonstrated through the superior dispatch efficiency of the developed data-driven models for solving the economic dispatch problem, with approximately 99\% accuracy for all dispatch predictions for the gradient boosting model. The modeling errors, however, are more pronounced with variations in water demand and grid connection profiles. Furthermore, the {SHAP} explainable artificial intelligence ({XAI}) technique is applied to interpret the model predictions and input--output relationships. Notably, the presented work enables the incorporation of offline data-driven systems for in-depth analysis of the impacts of dispatch decisions, thereby enhancing system robustness. This innovative approach holds significant promise for achieving cost-effective and sustainable power generation in line with global zero-carbon emission targets.},
  author={Iwakin, Oluwabunmi and Moazeni, Faegheh and Khazaei, Javad},
  journal={Energy},
  pages={137668},
  year={2025},
  publisher={Pergamon}
}

@incollection{iwakin2025artificial,
  title={Artificial Intelligence Techniques in LIBS Data Analysis and Interpretation},
  doi={10.1007/978-3-031-90970-2_11},
  abstract={Laser-induced breakdown spectroscopy ({LIBS}) remains widely utilized in various scientific and industrial applications for its fast, in situ, quasi-nondestructive analysis of materials. However, the size and complexity of the datasets generated through {LIBS} necessitate efficient approaches for their handling and interpretation. This chapter examines the application of artificial intelligence ({AI}) techniques to manage large volumes of multidimensional {LIBS} data and enhance analytical processes, including data analysis and interpretation while highlighting its role in improving real-time analysis and decision-making. Focusing on waste-to-energy applications, this chapter demonstrates how {AI} models, including support vector regression ({SVR}) and random forest ({RF}), streamline the prediction of critical waste properties such as proximate and ash elemental analyses and heating values. These models and cross-validation techniques ensure high generalization ability for {LIBS} qualitative/quantitative analyses, demonstrating the transformative potential of {AI} in optimizing industrial workflows and driving sustainable technological innovations.},
  author={Iwakin, Oluwabunmi and Liu, Jincheng and Craparo, Joe and Cheng, Liang and Moazeni, Faegheh and De Saro, Robert and Yao, Zheng and Romero, Carlos E},
  booktitle={Laser Induced Breakdown Spectroscopy (LIBS) Chemometrics, Environmental and Forensic Applications},
  pages={239--253},
  year={2025},
  publisher={Springer Nature Switzerland, Cham}
}

@incollection{liu2025machine,
  title={Machine Learning in the Context of Laser-Induced Breakdown Spectroscopy},
  doi={10.1007/978-3-031-90970-2_10},
  abstract={This chapter explores the integration of machine learning ({ML}) with Laser-Induced Breakdown Spectroscopy ({LIBS}), a powerful technique for elemental analysis. The combination of {ML} and {LIBS} enhances data processing, enabling more precise material classification, elemental concentration predictions, and complex dataset interpretation. The chapter begins by introducing the fundamental concepts of machine learning, including supervised, unsupervised, and deep learning methods, and their applications within the context of {LIBS}. Key supervised machine learning techniques such as decision trees, random forests, support vector machines, and neural networks are analyzed, highlighting their roles in improving {LIBS} accuracy and efficiency. The chapter also emphasizes the importance of data splitting and feature selection to optimize model performance. Special attention is given to advanced methods like Gaussian process regression and self-organizing maps, which offer probabilistic and unsupervised approaches to spectral data analysis. The chapter concludes by addressing the ongoing challenges in applying machine learning to {LIBS}, including computational demands and model interpretability, while outlining the potential future advancements that will further enhance the analytical capabilities of {LIBS}.},
  author={Liu, Jincheng and Iwakin, Oluwabunmi and Cheng, Liang and Moazeni, Faegheh and Yao, Zheng and Romero, Carlos E},
  booktitle={Laser Induced Breakdown Spectroscopy (LIBS) Chemometrics, Environmental and Forensic Applications},
  pages={223--237},
  year={2025},
  publisher={Springer Nature Switzerland, Cham}
}

@article{iwakin2026deep,
  title={Deep learning-enhanced economic dispatch for integrated microgrid-water systems with desalination},
  doi={10.1016/j.jwpe.2025.109316},
  abstract={The impacts of climate change and the rapid depletion of freshwater resources underscore the urgent need for the exploitation of alternative water and energy resources to ensure the sustainable operation and management of the critical infrastructure associated with them. This paper proposes a mixed integer nonlinear programming economic dispatch model for the joint operation and management of integrated water-microgrid systems, while accounting for maintenance, reliability and environmental constraints within a unified framework. This study further tackles the associated computational complexity that might arise from solving such optimization problems, particularly for large systems, by developing a multichannel convolutional neural network model for realtime economic dispatch solutions under different operational conditions. The case studies analyzed in this work demonstrate that, under specific conditions, investments in maintaining battery energy storage system charge availability at the end of each day can lead to substantial operational and emissions cost savings, reaching up to \$8.4/day for the system under consideration. The developed data-driven approach also highlights the role of historical dispatch information on providing contextual insight offering more-informed future scheduling decisions, and with up to 94\% in performance improvements from baseline models.},
  author={Iwakin, Oluwabunmi and Moazeni, Faegheh},
  journal={Journal of Water Process Engineering},
  volume={81},
  pages={109316},
  year={2026},
  publisher={Elsevier}
}

@inproceedings{iwakin2026optimal,
  title={Optimal Scheduling for Water-Energy Systems Based on Data-Driven Learned Constraints},
  doi={10.1061/9780784486931.064},
  abstract={The strong interdependence between water and energy systems is primarily accounted for in the utilization of dispatched energy for the operation of pumps. The optimal utilization of water resources and the scheduling of pumps could provide substantial energy and financial cost savings of up to 23\%. However, the optimal scheduling for water distribution systems remains a challenging nonconvex mixed-integer nonlinear programming problem. Existing approaches often rely on heuristics, which lack guarantees of global optimality, or adopt linear approximations that introduce numerous auxiliary variables and significantly increase computational burden. To address this challenge, we propose a novel linearization framework for the original {MINLP} problem that directly embeds machine-learning models trained to learn system constraints into the optimization formulation. We leverage the ability of machine learning models to learn complex nonlinear relationships between variables and their representability in mixed-integer optimization, including linear regression and multilayer perceptron neural networks, to linearize dynamic headloss and pump head curve relationships. We demonstrate the applicability of this approach using two small water distribution networks connected with a microgrid. We show that the presented approach offers competitive computational efficiency and improved solution quality compared to existing methods.},
  author={Iwakin, Oluwabunmi and Khazaei, Javad and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2026},
  pages={788--798},
  year={2026}
}

@inproceedings{putri2025intaset,
  title={InTaSet: A benchmark dataset for data-driven system identification and fault detection in an interconnected water system},
  doi={10.1061/9780784486931.058},
  abstract={Data-driven methods for dynamic model identification, forecasting, and fault detection in water systems research have received significant attention. However, validating these learning-based methods remains a challenge. Simulation-generated datasets, although easily accessible, rely on simplified disturbance descriptions and lack sensor drift. As a result, models trained may fail to transfer reliably to real-world physical systems. Simultaneously, physical laboratory-scale testbeds are expensive to build and rarely available to the broader community. This limits researchers' ability to benchmark new algorithms for diverse applications under realistic hydraulic dynamics. This work bridges the gap by introducing the Interconnected Tank Dataset ({InTaSet}), a carefully curated, publicly available benchmark dataset generated from a laboratory-scale quadruple-tank system. The dataset provides (1) training and testing datasets for system identification purposes under four separate experimental setups and (2) various sensor fault scenarios to mimic sensor drift in real-world systems. The dataset is equipped with (1) real-world sensor noise and actuator imperfections with high resolution at 0.1 s time interval, (2) rich excitation and multiple operating modes, and (3) a unified structure designed to evaluate a wide range of applications for data-driven identification, prediction, and fault-detection algorithms. The interconnected and reconfigurable quadruple-tank system exhibits cross-coupling and nonlinear dynamics, offering a compelling testbed for validating data-driven methods. Researchers can utilize the data to test algorithms offline, ensuring fair and reproducible comparisons. To support fair comparison across methods, we include a Neural {ODE}-based system identification baseline developed using the {InTaSet} data.},
  author={Putri, Saskia A and Vilacres, Daniela and Raza, Nazia and Iwakin, Oluwabunmi and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2026},
  pages={720--732},
  year={2026},
  dataset={https://zenodo.org/records/17652851}
}

@inproceedings{iwakin2026uncertainty,
  title={An Uncertainty-Aware Leakage Detection Framework Based on Monte Carlo Dropout Neural Network},
  doi={10.1061/9780784486931.060},
  abstract={Leakage is a critical challenge in water distribution systems, leading to significant water and economic losses. Traditional detection methods are either invasive (costly and impractical for large networks) or non-invasive, including hardware-based, model-based, and data-driven approaches. While hardware solutions are expensive and model-based approaches are computationally intensive, data-driven methods offer a more scalable alternative. However, their deterministic predictions provide no quantification of uncertainty, limiting their reliability for real-time decision-making. To address this gap, we propose a novel, non-invasive leakage detection framework based on a Monte Carlo Dropout ({MCD}) neural network. An {MCD} model integrates Monte Carlo sampling with dropout regularization, enabling both uncertainty quantification and overfitting prevention. By using predictive distributions rather than single outputs, we quantify epistemic uncertainties and establish robust detection thresholds, ensuring that leakage detection explicitly incorporates confidence levels in the model's predictions. We evaluate the framework on the Net3 benchmark network using {EPANET} simulations to generate normal and leakage events. The {MCD} model is trained solely on leak-free data, enabling it to detect anomalies when leakage occurs during inference. Results show that incorporating uncertainty intervals ensures detection reliability, reduces false alarms, and supports risk-aware operational decisions. This framework offers a scalable, real-time, software-based solution for uncertainty-informed leakage detection in modern water utilities.},
  author={Iwakin, Oluwabunmi and Raza, Nazia and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2026},
  pages={742--754},
  year={2026}
}

@inproceedings{raza2025wdseventdb,
  title={WDSEventDB: A Real-Time Benchmark Dataset for Event Diagnosis in Water Distribution Networks},
  doi={10.1061/9780784486931.069},
  abstract={Water distribution networks ({WDS}) are critical infrastructures whose security against stress and failures is vital to societal well-being and socio-economic development. Recent technological advances in sensor technologies have enabled the collection of real-time hydraulic datasets. These datasets can be leveraged to develop data-driven models for real-time event detection in {WDS}. However, most existing datasets remain proprietary and inaccessible to the public. Moreover, publicly available databases are limited in scope, as they focus on a single event type (e.g., leakages) and rely on hydraulic simulations. To address these limitations, we introduce a {WDS} Event Diagnosis Benchmark ({WDSEventDB}), a publicly available real-time sensor dataset designed to support the development of event-detection frameworks for diverse anomalies within {WDS}, including cyber-physical attacks, leakages, and sensor failures. The dataset is curated in real-time from a lab-scale {WDS} by emulating failures. We also provide four baseline detection models to facilitate benchmarking and advance research in {WDS}.},
  author={Raza, Nazia and Iwakin, Oluwabunmi and Vilacres, Daniela and Putri, Saskia and Moazeni, Faegheh},
  booktitle={World Environmental and Water Resources Congress 2026},
  pages={847--857},
  year={2026},
  dataset={https://zenodo.org/records/17547955}
}

@article{ploussard2026milp,
  title={When MILP Beats QP: Piecewise-Linear Reformulations of Sequentially Coupled Bilinear Programs},
  doi={10.48550/arXiv.2608.27312},
  abstract={The presence of bilinear terms in mathematical modeling generally yields nonconvex quadratic programs (QPs) that remain computationally challenging to solve to global optimality. While continuous piecewise linear (CPWL) approximations can reformulate these nonlinearities into mixed-integer linear programs (MILPs), the geometric construction of the domain partition heavily dictates the resulting solver efficiency. In this paper, we present efficient MILP formulations for approximating bilinear terms and rigorously evaluate their computational merits against direct QP solvers. First, we introduce CPWL approximations with arbitrary high degrees of accuracy that explicitly account for and exploit the inherent symmetries of the unit bilinear function. Second, we analytically establish the exact maximum and average approximation errors of the CPWL approximations. Third, we construct and compare three distinct MILP formulations (a ``Triangle'', a ``Square'', and a difference-of-convex ``DC'' formulation) of the CPWL functions. Fourth, we formalize a highly relevant class of optimization models, Sequentially Coupled Bilinear Programs (SCBP), where variables represent system states and state changes. Finally, through extensive numerical experiments, we demonstrate that our compact ``Square'' MILP formulation achieves superior computational performance on SCBP instances with long sequence horizons, allowing mature open-source MILP solvers to effectively outperform QP solvers.},
  author={Ploussard, Quentin and Usis, Maris and Iwakin, Oluwabunmi and Pavi{\v{c}}evi{\'c}, Matija},
  journal={arXiv preprint arXiv:2608.27312},
  year={2026},
  selected={true}
}

