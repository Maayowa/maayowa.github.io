<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div class="news-list">
      {% for item in news limit: news_limit %}
        <article class="news-item">
          <p class="news-meta">
            <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%B %Y' }}</time>
            {% if item.category %}<span class="news-cat">{{ item.category }}</span>{% endif %}
          </p>
          {% if item.inline %}
            {% if item.title %}<h3 class="news-headline">{{ item.title }}</h3>{% endif %}
            <div class="news-body">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
          {% else %}
            <h3 class="news-headline"><a href="{{ item.url | relative_url }}">{{ item.title }}</a></h3>
          {% endif %}
          {% if item.link %}
            <p class="news-link"><a href="{{ item.link }}">{{ item.link_text | default: 'Learn more' }} &rarr;</a></p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>